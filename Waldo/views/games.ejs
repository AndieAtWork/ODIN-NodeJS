<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/styles/styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">

    <title>Where's Waldo?</title>
</head>
<body class="no-stretch">
    <div id="choose-games-body">
        <div id="choose-games-content">
            <div id="choose-games-title">
                <h1>CHOOSE A GAME TO START!</h1>
            </div>
            <div id="game-grid">
                <div class="game-option">
                    <img src="/images/thumbnail/waldo1.jpg" class="game-option-thumbnail">
                    <button onclick="play(1);">PLAY</button>
                </div>
                <div class="game-option">
                    <img src="/images/thumbnail/waldo2.jpg" class="game-option-thumbnail">
                    <button onclick="play(2);">PLAY</button>
                </div>
                <div class="game-option">
                    <img src="/images/thumbnail/waldo3.jpg" class="game-option-thumbnail">
                    <button onclick="play(3);">PLAY</button>
                </div>
                <div class="game-option">
                    <img src="/images/thumbnail/waldo4.jpg" class="game-option-thumbnail">
                    <button onclick="play(4);">PLAY</button>
                </div>
                <div class="game-option">
                    <img src="/images/thumbnail/waldo5.jpg" class="game-option-thumbnail">
                    <button onclick="play(5);">PLAY</button>
                </div>
                <div class="game-option">
                    <img src="/images/thumbnail/waldo6.jpg" class="game-option-thumbnail">
                    <button onclick="play(6);">PLAY</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<script src="/javascript/game_engine.js"></script>